              },
              {
                "textRuns": [
                  {
                    "value": "How to use",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Use the available filters to analyse performance by year, month, plant and product. ",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The V1 Dashboard provides a high-level management overview of sales and production performance. The dedicated analysis pages provide more detailed perspectives: ",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Sales Analysis – sales performance against budget and actual sales distribution by channel;",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Production Analysis – production performance against budget and comparison with sales;",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Plant Analysis – production performance and product mix by production plant;",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Product Analysis – performance and production/sales relationships by product. ",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Use the Reset filters button to return each analysis page to its predefined default view.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The V1 Dashboard uses a different KPI colour logic from the detailed analysis tables. The top-level KPI cards provide a high-level management overview rather than a traffic-light status system. In detailed budget analysis tables, negative variances and budget attainment below 100% are highlighted in red to support exception analysis.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Sales-channel views support the analysis of actual sales, allocated budgets, variances and budget attainment by channel.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The different views are intended to support both high-level monitoring and deeper analysis of the factors behind the results.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
