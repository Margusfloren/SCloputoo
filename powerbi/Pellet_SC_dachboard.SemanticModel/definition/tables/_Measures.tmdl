	measure 'Production Actual KPI Display' =
			
			VAR _Value =
			    [Production Actual Selected Period]
			
			RETURN
			    IF (
			        ISBLANK ( _Value ),
			        BLANK(),
			        SWITCH (
			            TRUE(),
			            ABS ( _Value ) < 1000000,
			                DIVIDE ( _Value, 1000 ),
			            DIVIDE ( _Value, 1000000 )
			        )
			    )
		lineageTag: c723a8a5-a5fa-479e-b21f-6d44902d2adf

		formatStringDefinition =
				VAR _Value =
				    ABS ( [Production Actual Selected Period] )
				
				RETURN
				    SWITCH (
				        TRUE(),
				        _Value < 10000,   "0.00""K""",
				        _Value < 100000,  "0.0""K""",
				        _Value < 1000000, "0""K""",
				                          "0.00""M"""
				    )

