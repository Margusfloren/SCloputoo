	measure 'Sales Actual Selected Period All Channels' =
			
			CALCULATE(
			    [Sales Actual Selected Period],
			    REMOVEFILTERS('gold dim_channel'),
			    REMOVEFILTERS('gold fact_sales'[channel_id])
			)
		lineageTag: cd8300af-b9c4-499c-a42f-0fa3f597e486

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Variance KPI' =
			
			[Sales Variance Selected Period]
		lineageTag: ad793090-5bd2-4cb1-9c31-99811608f036

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Production Chart Title' =
			
			VAR SelectedChart =
			    MAXX(
			        SUMMARIZE(
			            'Production Chart Selector',
			            'Production Chart Selector'[Production Chart Selector],
			            'Production Chart Selector'[Production Chart Selector Fields]
			        ),
			        'Production Chart Selector'[Production Chart Selector]
			    )
			
			RETURN
			    SWITCH(
			        SelectedChart,
			        "Production Budget", "Production Actual vs Budget",
			        "Sales Actual", "Production Actual vs Sales",
			        "Production Actual"
			    )
		lineageTag: c36c883a-369a-400b-a3c1-14d3f69d59c2

	measure 'Sales Actual KPI' =
			
			[Sales Actual Selected Period]
		lineageTag: ae8b2317-56b9-4607-ba25-648d2b18b213

		formatStringDefinition =
				VAR v = [Sales Actual KPI]
				
				RETURN
				    SWITCH(
				        TRUE(),
				        ABS(v) >= 1000000, "0.00,, ""M""",
				        ABS(v) >= 1000,    "0, ""K""",
				        "0"
				    )

	measure 'Sales Actual KPI Display' =
			
			VAR _Value =
			    [Sales Actual Selected Period]
			
			RETURN
			    IF (
			        ISBLANK ( _Value ),
			        BLANK(),
			        SWITCH (
			            TRUE(),
			            ABS ( _Value ) < 10000,
			                FORMAT ( _Value / 1000, "0.00" ) & "K",
			
			            ABS ( _Value ) < 100000,
			                FORMAT ( _Value / 1000, "0.0" ) & "K",
			
			            ABS ( _Value ) < 1000000,
			                FORMAT ( _Value / 1000, "0" ) & "K",
			
			            FORMAT ( _Value / 1000000, "0.00" ) & "M"
			        )
			    )
		lineageTag: 7244fdd4-29ae-4c0e-98d6-ce41ac179b4c

