		lineageTag: b4e6295e-a3ff-4da3-b909-f6e5f8390b5d

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Sales Actual YTD' =
			
			COALESCE(
			    TOTALYTD(
			        [Sales Actual],
			        'gold dim_date'[date]
			    ),
			    0
			)
		lineageTag: fb2084be-0df2-4b6d-9ead-0f445cca637b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Budget YTD' =
			
			COALESCE(
			    TOTALYTD(
			        [Sales Budget],
			        'gold dim_date'[date]
			    ),
			    0
			)
		lineageTag: 71466149-0204-4f97-ad92-6e392e86e350

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Variance YTD' = [Sales Actual YTD]-[Sales Budget YTD]
		formatString: 0.00
		lineageTag: 7bc9d6a0-2fda-4c25-bc13-c4b886bc463d

	measure 'Budget Attainment YTD %' =
			
			VAR Actual = [Sales Actual Selected Period]
			VAR Budget = [Sales Budget Selected Period]
			
			RETURN
			IF(
			    Budget = 0,
			    BLANK(),
			    DIVIDE(Actual, Budget)
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6dd75860-a00c-4b8d-887e-829ac01eaeb3

	measure 'Budget Attainment Status' =
			VAR Actual = [Sales Actual YTD]
			VAR Budget = [Sales Budget YTD]
			
			RETURN
			SWITCH(
			    TRUE(),
			    Budget = 0 && Actual = 0, "No plan / no sales",
			    Budget = 0 && Actual > 0, "Unbudgeted sales",
			    BLANK()
			)
		lineageTag: c3937e9d-d59b-477e-b024-dd83022f2484

	measure 'Sales Actual Selected Period' =
			
			COALESCE(
			    [Sales Actual],
			    0
			)
		formatString: 0.00
		lineageTag: 6ab7087a-7710-4665-88fc-ef102d236f58

